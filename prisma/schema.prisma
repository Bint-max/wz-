// 个人博客数据库模型设计
// 使用 Prisma ORM 管理 PostgreSQL 数据库

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------
// 用户表：后台管理员 / 作者
// ---------------------------------------------------------------
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  avatar       String?
  bio          String?   @db.Text
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  posts Post[]

  @@map("users")
}

enum Role {
  ADMIN
  EDITOR
}

// ---------------------------------------------------------------
// 分类表：技术分享 / 工作总结 / 学习笔记 / 项目经验 / 随笔
// ---------------------------------------------------------------
model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?  @db.Text
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  posts      Post[]
  aiArticles AiArticle[]

  @@map("categories")
}

// ---------------------------------------------------------------
// 标签表：与技术文章多对多关联
// ---------------------------------------------------------------
model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  posts PostTag[]

  @@map("tags")
}

// ---------------------------------------------------------------
// 文章表
// ---------------------------------------------------------------
model Post {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String?   @db.Text
  content     String    @db.Text
  coverImage  String?
  published   Boolean   @default(false)
  featured    Boolean   @default(false)
  views       Int       @default(0)
  readingTime Int       @default(1)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  aiGenerated Boolean    @default(false) // 是否由 AI 生成
  aiArticle   AiArticle?

  category   Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId String?
  author     User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId   String

  tags     PostTag[]
  comments Comment[]

  @@index([published, publishedAt])
  @@index([categoryId])
  @@index([authorId])
  @@map("posts")
}

// ---------------------------------------------------------------
// 文章-标签 关联表
// ---------------------------------------------------------------
model PostTag {
  postId String
  tagId  String

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@map("post_tags")
}

// ---------------------------------------------------------------
// 评论表：支持审核、删除与简单反垃圾机制
// ---------------------------------------------------------------
model Comment {
  id         String       @id @default(cuid())
  postId     String
  authorName String
  authorEmail String?
  content    String       @db.Text
  status     CommentStatus @default(PENDING)
  ip         String?
  parentId   String?
  createdAt  DateTime     @default(now())

  post    Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentReplies")

  @@index([postId])
  @@index([status])
  @@map("comments")
}

enum CommentStatus {
  PENDING
  APPROVED
  SPAM
  REJECTED
}

// ---------------------------------------------------------------
// 站点设置表：key-value 形式保存站点标题、简介、头像、GitHub 等
// ---------------------------------------------------------------
model SiteSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

// ---------------------------------------------------------------
// 访问统计表：按天聚合全站访问量
// ---------------------------------------------------------------
model VisitStat {
  id    String   @id @default(cuid())
  date  DateTime @db.Date
  count Int      @default(0)

  @@unique([date])
  @@map("visit_stats")
}

// ===============================================================
// AI 内容生产模块
// ===============================================================

enum NewsSourceType {
  RSS
  API
}

enum AiRunStatus {
  RUNNING
  SUCCESS
  FAILED
  PARTIAL
}

// ---------------------------------------------------------------
// 新闻来源表
// ---------------------------------------------------------------
model NewsSource {
  id                String         @id @default(cuid())
  name              String
  type              NewsSourceType @default(RSS)
  url               String
  enabled           Boolean        @default(true)
  newsType          String?        // 新闻类型，如 科技 / 财经 / 体育
  defaultCategoryId String?
  defaultTags       String[]       @default([])
  config            Json?
  lastFetchedAt     DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  items NewsItem[]

  @@index([enabled])
  @@index([newsType])
  @@map("news_sources")
}

// ---------------------------------------------------------------
// 采集到的新闻表
// ---------------------------------------------------------------
model NewsItem {
  id          String    @id @default(cuid())
  sourceId    String
  title       String
  url         String
  urlHash     String    @unique
  summary     String?   @db.Text
  content     String?   @db.Text
  newsType    String?   // 新闻类型（继承自来源）
  publishedAt DateTime?
  hotScore    Float?
  used        Boolean   @default(false)
  fetchedAt   DateTime  @default(now())

  source    NewsSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  aiArticle AiArticle?

  @@index([sourceId])
  @@index([newsType])
  @@index([publishedAt])
  @@map("news_items")
}

// ---------------------------------------------------------------
// AI 生成记录 / 草稿表
// status: 0 = 草稿, 1 = 已发布
// ---------------------------------------------------------------
model AiArticle {
  id                  String    @id @default(cuid())
  newsItemId          String?   @unique
  title               String
  slug                String    @unique
  summary             String?   @db.Text
  content             String    @db.Text
  keywords            String[]  @default([])
  tags                String[]  @default([])
  suggestedCategoryId String?
  status              Int       @default(0)
  sourceUrl           String?
  model               String?
  tokenUsage          Int?
  cost                Float?
  error               String?   @db.Text
  postId              String?   @unique
  publishedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  newsItem NewsItem? @relation(fields: [newsItemId], references: [id], onDelete: SetNull)
  category Category? @relation(fields: [suggestedCategoryId], references: [id], onDelete: SetNull)
  post     Post?     @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
  @@map("ai_articles")
}

// ---------------------------------------------------------------
// 任务运行日志表
// ---------------------------------------------------------------
model AiRunLog {
  id           String      @id @default(cuid())
  runType      String
  status       AiRunStatus @default(RUNNING)
  startedAt    DateTime    @default(now())
  endedAt      DateTime?
  totalItems   Int         @default(0)
  successCount Int         @default(0)
  errorCount   Int         @default(0)
  message      String?     @db.Text
  createdAt    DateTime    @default(now())

  @@index([runType, createdAt])
  @@map("ai_run_logs")
}

// ===============================================================
// 音乐播放器模块
// ===============================================================

enum MusicStatus {
  ACTIVE
  DISABLED
}

// ---------------------------------------------------------------
// 音乐表：前台播放器 + 后台音乐管理
// category 为场景标签，可填文章分类 slug（如 tech / life）或特殊场景 home
// ---------------------------------------------------------------
model Music {
  id         String      @id @default(cuid())
  title      String
  artist     String
  cover      String?     // 封面地址
  url        String      // 音乐文件地址
  lyric      String?     // 歌词文件地址（.lrc / .txt）
  category   String?     // 场景标签：文章分类 slug 或 home（首页背景音乐）
  isRecommend Boolean    @default(false) // 推荐歌曲
  isHomeBgm  Boolean     @default(false) // 是否作为首页背景音乐
  playCount  Int         @default(0)
  sort       Int         @default(0)
  status     MusicStatus @default(ACTIVE)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([status, sort])
  @@index([category])
  @@map("music")
}
