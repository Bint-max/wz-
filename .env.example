# PostgreSQL 连接串（本地开发可使用 docker-compose 中的默认配置）
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/personal_blog?schema=public"

# JWT 签名密钥，生产环境请更换为随机长字符串
JWT_SECRET="please-change-me-to-a-long-random-secret"

# 站点地址，用于 SEO / RSS / 站点地图
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# 是否允许公开注册（本博客默认仅允许种子管理员登录）
NEXT_PUBLIC_ALLOW_REGISTER="false"

# AI 内容生产模块
# DeepSeek API（OpenAI 兼容接口）
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-chat"
DEEPSEEK_BASE_URL="https://api.deepseek.com"
# 定时任务接口密钥（调用 /api/cron/ai-daily 时需要携带）
CRON_SECRET="change-me-cron-secret"
# 管理员通知 Webhook（飞书/钉钉/企业微信，可选）
NOTIFY_WEBHOOK_URL=""

# RSSHub 地址（可选，默认公共实例 https://rsshub.app；建议自建后填写）
RSSHUB_BASE_URL=""
